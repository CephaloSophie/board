# Port the client dev/preview server listens on.
VITE_PORT=7001
# Where the client proxies /api requests (the API server).
VITE_API_PROXY_TARGET=http://localhost:7002

# Optional: direct WebSocket origin for the realtime ceremonies (Planning
# Poker + Retrospective). Leave EMPTY if the app is served by the API server
# itself (single origin — recommended in production). Set it only when the
# client is on a DIFFERENT origin than the API (e.g. the Vite server on :7001),
# because Vite's WebSocket proxy is unreliable and Chrome then reports
# "Invalid frame header". Point it straight at the API's ws:// origin, e.g.:
# VITE_WS_BASE=ws://217.160.186.250:7002
VITE_WS_BASE=
